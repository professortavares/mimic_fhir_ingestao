{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",

      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(.env)",
      "Write(**/.env)",
      "Write(**/.env.*)",

      "Bash(cat * .env*)",
      "Bash(head * .env*)",
      "Bash(tail * .env*)",
      "Bash(less * .env*)",
      "Bash(more * .env*)",
      "Bash(grep * .env*)",
      "Bash(rg * .env*)",
      "Bash(sed * .env*)",
      "Bash(awk * .env*)",
      "Bash(diff * .env*)",

      "Bash(sudo *)",
      "Bash(su *)"
    ]}
}